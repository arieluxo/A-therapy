# Ejemplo de variables de entorno — A-THERAPY
# Copiar a `.env` y rellenar. NUNCA commitear el `.env` real.

# SQLite local (desarrollo)
DATABASE_URL="file:./db/custom.db"

# Secreto JWT (producción: valor largo aleatorio en Vercel → Settings → Environment Variables)
JWT_SECRET="cambia-este-valor-en-produccion"
