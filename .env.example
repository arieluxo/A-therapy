# Ejemplo de variables de entorno — A-THERAPY
# Copiar a `.env` y rellenar. NUNCA commitear el `.env` real.
# En Vercel estas variables las inyecta la integración de Neon Postgres.

# Conexión pooled (runtime de la app). Con PgBouncer en modo transacción
# Prisma exige pgbouncer=true + connection_limit=1.
DATABASE_URL="postgresql://USUARIO:PASSWORD@HOST-pooler.REGION.aws.neon.tech/BD?sslmode=require&pgbouncer=true&connection_limit=1"

# Conexión directa (solo para `prisma db push` / migrate desde local).
DIRECT_URL="postgresql://USUARIO:PASSWORD@HOST.REGION.aws.neon.tech/BD?sslmode=require"

# Secreto JWT (producción: valor largo aleatorio en Vercel → Settings → Environment Variables)
JWT_SECRET="cambia-este-valor-en-produccion"
